# Skopiruj tento subor ako .env a uprav hodnoty

# Port na ktorom bezi Node.js server
PORT=3000

# Prihlasovacie meno pre admin rozhranie
ADMIN_USER=admin

# Pociatocne heslo pre admin (pouzije sa len pri prvom starte, potom ho zmen v admin > Heslo)
ADMIN_PASSWORD=zmen-ma-hned-123

# Nahodny dlhy retazec pre podpisovanie session cookies
SESSION_SECRET=zmen-ma-na-nieco-dlhe-a-nahodne

# true len ak bezi web za reverse proxy s HTTPS (Traefik), inak nechaj false
TRUST_PROXY=false
