<%- include('_head', { title: 'Aktuality' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Aktuality</h1>

  <div class="card">
    <h3 style="margin-top:0">Pridať novinku</h3>
    <form method="POST" action="/admin/news" enctype="multipart/form-data">
      <div class="grid-2">
        <div><label>Dátum</label><input type="date" name="date" required></div>
        <div><label>Nadpis</label><input type="text" name="title" required></div>
      </div>
      <label>Krátky text</label>
      <textarea name="excerpt" required></textarea>

      <label>Obrázok – nahrať súbor</label>
      <input type="file" name="imageFile" accept="image/*">
      <label>alebo URL obrázka (ak nenahrávaš súbor)</label>
      <input type="url" name="imageUrl" placeholder="https://...">

      <button class="btn" type="submit">Pridať</button>
    </form>
  </div>

  <div class="card">
    <table>
      <thead><tr><th>Foto</th><th>Dátum</th><th>Nadpis</th><th></th></tr></thead>
      <tbody>
        <% news.forEach(function(n) { %>
        <tr>
          <td><img class="thumb" src="<%= n.image %>" alt=""></td>
          <td><%= n.date %></td>
          <td><%= n.title %></td>
          <td class="row-actions" style="white-space:nowrap">
            <a class="btn btn-secondary" href="/admin/news/<%= n.id %>/edit" style="margin-top:0;padding:6px 10px;font-size:11px">Upraviť</a>
            <form method="POST" action="/admin/news/<%= n.id %>/delete" onsubmit="return confirm('Naozaj odstrániť túto novinku?')">
              <button class="btn btn-danger" type="submit" style="margin-top:0;padding:6px 10px;font-size:11px">Zmazať</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
