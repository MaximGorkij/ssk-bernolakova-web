<%- include('_head', { title: 'Galéria' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Galéria</h1>
  <p style="color:#68758a;font-size:13px">Na úvodnej stránke sa zobrazuje prvých 5 fotiek.</p>

  <div class="card">
    <h3 style="margin-top:0">Pridať fotku</h3>
    <form method="POST" action="/admin/gallery" enctype="multipart/form-data">
      <label>Nahrať súbor</label>
      <input type="file" name="imageFile" accept="image/*">
      <label>alebo URL obrázka</label>
      <input type="url" name="imageUrl" placeholder="https://...">
      <label>Popis (voliteľné)</label>
      <input type="text" name="caption">
      <button class="btn" type="submit">Pridať</button>
    </form>
  </div>

  <div class="card">
    <table>
      <thead><tr><th>Foto</th><th>Popis</th><th></th></tr></thead>
      <tbody>
        <% gallery.forEach(function(g) { %>
        <tr>
          <td><img class="thumb" src="<%= g.image %>" alt=""></td>
          <td><%= g.caption %></td>
          <td class="row-actions">
            <form method="POST" action="/admin/gallery/<%= g.id %>/delete" onsubmit="return confirm('Naozaj odstrániť túto fotku?')">
              <button class="btn btn-danger" type="submit" style="margin-top:0;padding:6px 10px;font-size:11px">Zmazať</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
