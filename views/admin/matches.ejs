<%- include('_head', { title: 'Zápasy' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Zápasy a výsledky</h1>

  <div class="card">
    <h3 style="margin-top:0">Pridať zápas</h3>
    <form method="POST" action="/admin/matches" id="matchForm">
      <div class="grid-2">
        <div><label>Domáci tím</label><input type="text" name="homeTeam" value="ŠŠK Bernolákova" required></div>
        <div><label>Hosťujúci tím</label><input type="text" name="awayTeam" placeholder="Súper" required></div>
      </div>
      <div class="grid-2">
        <div><label>Dátum</label><input type="date" name="date" required></div>
        <div><label>Čas (voliteľné)</label><input type="time" name="time"></div>
      </div>
      <label>Miesto (voliteľné)</label>
      <input type="text" name="location" placeholder="Košice">

      <label>Stav</label>
      <select name="status" id="statusSelect" onchange="document.getElementById('scoreFields').style.display = this.value === 'finished' ? 'grid' : 'none'">
        <option value="upcoming">Nadchádzajúci</option>
        <option value="finished">Odohraný (so skóre)</option>
      </select>

      <div class="grid-2" id="scoreFields" style="display:none">
        <div><label>Skóre – domáci</label><input type="number" name="homeScore" min="0"></div>
        <div><label>Skóre – hostia</label><input type="number" name="awayScore" min="0"></div>
      </div>

      <label>Komentár / strelci (voliteľné)</label>
      <textarea name="comment" rows="3" placeholder="napr. Novák 3, Kováčová 2, Horváth 1"></textarea>

      <button class="btn" type="submit">Pridať zápas</button>
    </form>
  </div>

  <div class="card">
    <table>
      <thead><tr><th>Dátum</th><th>Zápas</th><th>Stav</th><th>Skóre</th><th></th></tr></thead>
      <tbody>
        <% matches.slice().sort((a,b)=> a.date < b.date ? 1 : -1).forEach(function(m) { %>
        <tr>
          <td><%= m.date %><% if (m.time) { %> <%= m.time %><% } %></td>
          <td><%= m.homeTeam %> – <%= m.awayTeam %><% if (m.location) { %><br><small style="color:#68758a"><%= m.location %></small><% } %><% if (m.comment) { %><br><small style="color:#68758a;white-space:pre-line"><%= m.comment %></small><% } %></td>
          <td><span class="badge <%= m.status === 'finished' ? 'badge-finished' : 'badge-upcoming' %>"><%= m.status === 'finished' ? 'ODOHRANÝ' : 'NADCHÁDZAJÚCI' %></span></td>
          <td><%= m.status === 'finished' ? (m.homeScore + ' : ' + m.awayScore) : '—' %></td>
          <td class="row-actions">
            <a class="btn btn-secondary" href="/admin/matches/<%= m.id %>/edit" style="margin-top:0;padding:6px 10px;font-size:11px">Upraviť</a>
            <form method="POST" action="/admin/matches/<%= m.id %>/delete" onsubmit="return confirm('Naozaj odstrániť tento zápas?')">
              <button class="btn btn-danger" type="submit" style="margin-top:0;padding:6px 10px;font-size:11px">Zmazať</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
