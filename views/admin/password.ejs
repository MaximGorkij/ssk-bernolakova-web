<%- include('_head', { title: 'Zmena hesla' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Zmena hesla</h1>
  <% if (saved) { %><div class="alert-ok">Heslo bolo zmenené.</div><% } %>
  <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
  <div class="card" style="max-width:420px">
    <form method="POST" action="/admin/password">
      <label>Súčasné heslo</label>
      <input type="password" name="currentPassword" required>
      <label>Nové heslo (min. 8 znakov)</label>
      <input type="password" name="newPassword" required minlength="8">
      <label>Nové heslo znova</label>
      <input type="password" name="newPassword2" required minlength="8">
      <button class="btn" type="submit">Zmeniť heslo</button>
    </form>
  </div>
</div>
</body>
</html>
