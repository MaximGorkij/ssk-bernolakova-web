<%- include('_head', { title: 'Družstvá' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Družstvá</h1>

  <div class="card">
    <h3 style="margin-top:0">Pridať družstvo</h3>
    <form method="POST" action="/admin/teams">
      <div class="grid-2">
        <div><label>Názov</label><input type="text" name="name" required></div>
        <div><label>Veková kategória</label><input type="text" name="ageRange" placeholder="napr. 9–11 rokov" required></div>
      </div>
      <label>URL fotky</label>
      <input type="url" name="photo" placeholder="https://..." required>
      <button class="btn" type="submit">Pridať</button>
    </form>
  </div>

  <div class="card">
    <table>
      <thead><tr><th>Foto</th><th>Názov</th><th>Kategória</th><th></th></tr></thead>
      <tbody>
        <% teams.forEach(function(t) { %>
        <tr>
          <td><img class="thumb" src="<%= t.photo %>" alt=""></td>
          <td><%= t.name %></td>
          <td><%= t.ageRange %></td>
          <td class="row-actions">
            <form method="POST" action="/admin/teams/<%= t.id %>/delete" onsubmit="return confirm('Naozaj odstrániť toto družstvo?')">
              <button class="btn btn-danger" type="submit" style="margin-top:0;padding:6px 10px;font-size:11px">Zmazať</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
