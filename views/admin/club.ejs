<%- include('_head', { title: 'Klub' }) %>
<%- include('_nav') %>
<div class="wrap">
  <h1>Nastavenia klubu</h1>
  <% if (saved) { %><div class="alert-ok">Uložené.</div><% } %>
  <div class="card">
    <form method="POST" action="/admin/club" enctype="multipart/form-data">
      <label>Logo klubu (jpg, png, webp, gif)</label>
      <% if (club.logo) { %><img src="<%= club.logo %>" alt="Aktuálne logo" style="height:80px;margin-bottom:8px"><% } %>
      <input type="file" name="logoFile" accept="image/*">

      <label>Nadpis na úvodnej strane (nový riadok = zalomenie)</label>
      <textarea name="heroTitle" style="min-height:60px" required><%= club.heroTitle %></textarea>

      <label>Text pod nadpisom</label>
      <textarea name="heroText" required><%= club.heroText %></textarea>

      <label>URL úvodného obrázka na pozadí</label>
      <input type="url" name="heroImage" value="<%= club.heroImage %>">

      <label>Nadpis sekcie "O klube" (nový riadok = zalomenie)</label>
      <textarea name="aboutTitle" style="min-height:60px" required><%= club.aboutTitle %></textarea>

      <label>Text sekcie "O klube"</label>
      <textarea name="aboutText" required><%= club.aboutText %></textarea>

      <label>Hodnoty klubu (jedna na riadok, môžeš použiť emoji)</label>
      <textarea name="values"><%= club.values.join('\n') %></textarea>

      <div class="grid-2">
        <div>
          <label>Kontaktný e-mail</label>
          <input type="email" name="contactEmail" value="<%= club.contactEmail %>">
        </div>
        <div>
          <label>Mesto</label>
          <input type="text" name="contactCity" value="<%= club.contactCity %>">
        </div>
      </div>

      <div class="grid-2">
        <div>
          <label>Facebook (URL)</label>
          <input type="url" name="facebook" value="<%= club.facebook %>">
        </div>
        <div>
          <label>Instagram (URL)</label>
          <input type="url" name="instagram" value="<%= club.instagram %>">
        </div>
      </div>

      <button class="btn" type="submit">Uložiť</button>
    </form>
  </div>
</div>
</body>
</html>
